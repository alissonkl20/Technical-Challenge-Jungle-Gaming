{
  "name": "technical-challenge-jungle-gaming",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.0.0 <2",
    "node": ">=22.17.0"
  },
  "scripts": {
    "start": "bun dist/src/main.js",
    "start:prod": "bun dist/src/main.js",
    "start:dev": "bun --watch src/main.ts",
    "start:outbox-worker": "bun dist/src/workers/outbox-worker.js",
    "start:outbox-worker:dev": "bun --watch src/workers/outbox-worker.ts",
    "start:sqs-event-worker": "bun dist/src/workers/sqs-event-worker.js",
    "start:sqs-event-worker:dev": "bun --watch src/workers/sqs-event-worker.ts",
    "start:pending-reference-worker": "bun dist/src/workers/pending-reference-worker.js",
    "start:pending-reference-worker:dev": "bun --watch src/workers/pending-reference-worker.ts",
    "outbox:redrive": "bun src/workers/outbox-redrive.ts",
    "build": "tsc --project tsconfig.build.json && tsc --noEmit --project tsconfig.json",
    "test": "bun test ./test/*.test.ts",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:load",
    "test:unit": "bun test ./test/finance-domain.test.ts ./test/wager-rules.test.ts ./test/request-identity.test.ts ./test/architecture.test.ts ./test/app.test.ts ./test/http-api.test.ts ./test/observability.test.ts ./test/integration-event.test.ts",
    "test:api": "RUN_POSTGRES_INTEGRATION=true bun test ./test/http-api.test.ts ./test/postgres-http-api.integration.test.ts ./test/postgres-http-idempotency.integration.test.ts ./test/postgres-http-resilience.integration.test.ts ./test/postgres-wagering-contract.integration.test.ts",
    "test:idempotency": "RUN_POSTGRES_INTEGRATION=true bun test ./test/postgres-idempotency.integration.test.ts ./test/postgres-http-idempotency.integration.test.ts ./test/postgres-wallet-replay.integration.test.ts --test-name-pattern='idempot|replay|external transaction ID'",
    "test:concurrency": "RUN_POSTGRES_INTEGRATION=true bun test ./test/postgres-idempotency.integration.test.ts ./test/postgres-pending-references.integration.test.ts ./test/postgres-wallet-concurrency.integration.test.ts ./test/postgres-wallet-replay.integration.test.ts ./test/postgres-multi-instance-contract.integration.test.ts --test-name-pattern='concurrent|contention|simultaneous|parallel|serializes|burst|instances'",
    "test:provider-isolation": "RUN_POSTGRES_INTEGRATION=true bun test ./test/postgres-provider-isolation.integration.test.ts",
    "test:immutability": "RUN_POSTGRES_INTEGRATION=true bun test ./test/postgres-schema-migrations.integration.test.ts ./test/postgres-database-invariants.integration.test.ts ./test/postgres-ledger-invariants.integration.test.ts --test-name-pattern='immutab|terminal|processed reversal|OPENING'",
    "test:consistency": "RUN_POSTGRES_INTEGRATION=true bun test ./test/postgres-financial-processing.integration.test.ts ./test/postgres-reversals.integration.test.ts ./test/postgres-ledger-invariants.integration.test.ts ./test/postgres-reconciliation.integration.test.ts --test-name-pattern='atomic|Ledger|balance|financial invariants|reconcil|reversal'",
    "test:messaging": "RUN_POSTGRES_INTEGRATION=true bun test ./test/postgres-inbox-outbox.integration.test.ts ./test/postgres-sqs-command-worker.integration.test.ts ./test/postgres-sqs-event-worker.integration.test.ts",
    "test:resilience": "RUN_POSTGRES_INTEGRATION=true bun test ./test/postgres-http-resilience.integration.test.ts ./test/postgres-pending-references.integration.test.ts ./test/postgres-sqs-command-worker.integration.test.ts ./test/postgres-sqs-event-worker.integration.test.ts --test-name-pattern='crash|fail|recover|retry|commit|transient|restart|lost|pending reference'",
    "test:security": "RUN_POSTGRES_INTEGRATION=true bun test ./test/postgres-provider-isolation.integration.test.ts ./test/postgres-database-invariants.integration.test.ts ./test/postgres-ledger-invariants.integration.test.ts --test-name-pattern='auth|forg|unauth|provider|identity|cross-provider|direct SQL'",
    "test:properties": "RUN_POSTGRES_INTEGRATION=true bun test ./test/postgres-financial-properties.integration.test.ts --test-name-pattern='generated|properties|seed|sequence'",
    "test:mutation": "RUN_POSTGRES_INTEGRATION=true bun test ./test/postgres-database-invariants.integration.test.ts ./test/postgres-ledger-invariants.integration.test.ts ./test/postgres-idempotency.integration.test.ts ./test/postgres-wallet-concurrency.integration.test.ts --test-name-pattern='direct SQL violations|wallet uniqueness|ledger immutability|scopes identical idempotency|processes exactly ten'",
    "lint": "biome lint .",
    "migration:create": "bun ./node_modules/@mikro-orm/cli/cli.js migration:create --config ./mikro-orm.config.ts",
    "migration:up": "bun ./node_modules/@mikro-orm/cli/cli.js migration:up --config ./mikro-orm.config.ts",
    "migration:down": "bun ./node_modules/@mikro-orm/cli/cli.js migration:down --config ./mikro-orm.config.ts",
    "migration:list": "bun ./node_modules/@mikro-orm/cli/cli.js migration:list --config ./mikro-orm.config.ts",
    "test:integration": "RUN_POSTGRES_INTEGRATION=true bun test ./test/postgres-schema-migrations.integration.test.ts ./test/postgres-wagering-contract.integration.test.ts ./test/postgres-http-api.integration.test.ts ./test/postgres-http-idempotency.integration.test.ts ./test/postgres-http-resilience.integration.test.ts ./test/postgres-financial-processing.integration.test.ts ./test/postgres-idempotency.integration.test.ts ./test/postgres-pending-references.integration.test.ts ./test/postgres-wallet-concurrency.integration.test.ts ./test/postgres-financial-properties.integration.test.ts ./test/postgres-wallet-replay.integration.test.ts ./test/postgres-reversals.integration.test.ts ./test/postgres-provider-isolation.integration.test.ts ./test/postgres-database-invariants.integration.test.ts ./test/postgres-ledger-invariants.integration.test.ts ./test/postgres-inbox-outbox.integration.test.ts ./test/postgres-sqs-command-worker.integration.test.ts ./test/postgres-sqs-event-worker.integration.test.ts ./test/postgres-reconciliation.integration.test.ts ./test/postgres-win-settlement.integration.test.ts ./test/postgres-wagering-rejections.integration.test.ts ./test/postgres-failed-state.integration.test.ts ./test/postgres-outbox-terminal.integration.test.ts ./test/postgres-pending-expiry.integration.test.ts ./test/postgres-lock-ordering.integration.test.ts ./test/postgres-correlation.integration.test.ts ./test/money-precision.integration.test.ts ./test/lock-wait-metric.integration.test.ts ./test/process-inflight-shutdown.integration.test.ts ./test/process-outbox-inflight.integration.test.ts ./test/process-shutdown.integration.test.ts ./test/postgres-multi-instance-contract.integration.test.ts ./test/postgres-out-of-order-matrix.integration.test.ts ./test/postgres-audit-regressions.integration.test.ts ./test/postgres-bet-result-slot.integration.test.ts ./test/postgres-recovery-compensation.integration.test.ts",
    "test:load": "RUN_FINANCIAL_LOAD=true RUN_POSTGRES_INTEGRATION=true bun test ./test/postgres-load.integration.test.ts ./test/postgres-load-scenarios.integration.test.ts",
    "test:load:extreme": "RUN_FINANCIAL_LOAD=true RUN_EXTREME_FINANCIAL_LOAD=true RUN_POSTGRES_INTEGRATION=true bun test ./test/postgres-load.integration.test.ts ./test/postgres-load-scenarios.integration.test.ts",
    "test:recovery": "RUN_POSTGRES_INTEGRATION=true bun test ./test/postgres-recovery-compensation.integration.test.ts ./test/postgres-http-resilience.integration.test.ts ./test/postgres-sqs-command-worker.integration.test.ts ./test/process-inflight-shutdown.integration.test.ts ./test/process-outbox-inflight.integration.test.ts",
    "test:bet-results": "RUN_POSTGRES_INTEGRATION=true bun test ./test/postgres-bet-result-slot.integration.test.ts ./test/postgres-out-of-order-matrix.integration.test.ts ./test/postgres-win-settlement.integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1163.0",
    "@mikro-orm/core": "7.2.7",
    "@mikro-orm/migrations": "7.2.7",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.7",
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "dotenv": "17.2.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@mikro-orm/cli": "7.2.7",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "bun-types": "1.4.4",
    "typescript": "7.0.2"
  }
}
