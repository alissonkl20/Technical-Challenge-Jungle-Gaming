NODE_ENV=development
PORT=3000
OUTBOX_METRICS_PORT=9464
SQS_EVENT_METRICS_PORT=9465
PENDING_REFERENCE_METRICS_PORT=9466
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SCHEMA=public
POSTGRES_DB=betting_db
POSTGRES_USER=betting_user
POSTGRES_PASSWORD=betting_password
POSTGRES_POOL_MAX=10
DATABASE_TRANSACTION_MAX_RETRIES=3
PENDING_REFERENCE_TTL_HOURS=24
PENDING_REFERENCE_INITIAL_DELAY_MS=5000
OUTBOX_RETRY_BASE_DELAY_MS=1000
OUTBOX_RETRY_MAX_DELAY_MS=60000
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=10
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=6
PENDING_REFERENCE_POLL_INTERVAL_MS=1000
PENDING_REFERENCE_BATCH_SIZE=50
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_ENDPOINT=http://localhost:4566
LOCALSTACK_PORT=4566
SQS_OUTBOX_QUEUE_NAME=test-queue
SQS_EVENT_QUEUE_NAME=test-queue
SQS_EVENT_DLQ_NAME=financial-events-dlq
SQS_EVENT_BATCH_SIZE=10
SQS_EVENT_WAIT_TIME_SECONDS=20
SQS_EVENT_VISIBILITY_TIMEOUT_SECONDS=30
SQS_EVENT_RETRY_VISIBILITY_SECONDS=5
SQS_EVENT_MAX_RECEIVE_COUNT=5
PROVIDER_API_KEYS={"provider-a":"provider-a-local-key-0123456789abcdef"}
PROVIDER_ADMIN_API_KEY=local-admin-key-0123456789abcdef0123
SQS_EVENT_POLL_INTERVAL_MS=1000
SQS_WAGER_COMMAND_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_COMMAND_DLQ_NAME=wager-transactions-dlq.fifo
# Post-commit compensation of wagers whose events could not be published.
# Off by default: exhausted recoveries wait in COMPENSATION_REQUIRED for an operator.
COMPENSATION_ENABLED=false
COMPENSATION_MAX_ATTEMPTS=6
COMPENSATION_RETRY_BASE_DELAY_MS=5000
OUTBOX_PUBLISH_TIMEOUT_MS=10000
